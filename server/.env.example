# Port the API/photo server listens on
PORT=3001
# URL the PHONE will use to reach this server (the QR code encodes it).
# Leave empty to auto-detect your LAN IP, or set it explicitly, e.g.
#   http://192.168.1.23:3001          (same Wi-Fi)
#   https://abcd-12-34.ngrok-free.app (ngrok / deployed host)
PUBLIC_BASE_URL=
